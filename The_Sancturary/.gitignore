# ========================================
# Unity project base ignores
# ========================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ========================================
# IDE/editor/OS specific ignores
# ========================================
.vs/
.gradle/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DS_Store
*.apk
*.aab
*.unitypackage
*.app

# ========================================
# Unity Crash/System Info
# ========================================
sysinfo.txt

# ========================================
# JetBrains Rider plugin (not using)
/Assets/Plugins/Editor/JetBrains* 

# ========================================
# Asset Store Tools (uncomment if used)
# /Assets/AssetStoreTools*

# ========================================
# Photon-specific ignores
# ========================================
# Ignore Photon demo assets
Assets/Photon/PhotonUnityNetworking/Demos/

# (Optional) Ignore PhotonServerSettings if teammates use separate App IDs
# Uncomment below if you want to keep Photon config private
# Assets/Photon/PhotonUnityNetworking/Resources/PhotonServerSettings.asset

# ========================================
# Addressables & StreamingAssets temp
# ========================================
Assets/AddressableAssetsData/*/*.bin*
Assets/StreamingAssets/aa.meta
Assets/StreamingAssets/aa/*

# ========================================
# Backup or temporary Unity files
# ========================================
*.bak
*.backup
